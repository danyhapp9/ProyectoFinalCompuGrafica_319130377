# sendero_petalos.obj - quad 1x1 sobre el suelo (normal +Y), centrado en el origen
mtllib sendero_petalos.mtl
o SenderoPetalos
v -0.5 0.0  0.5
v  0.5 0.0  0.5
v  0.5 0.0 -0.5
v -0.5 0.0 -0.5
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 1.0 0.0
usemtl PetalosSendero
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
